{
  "New book": {
    "scope": "markdown",
    "prefix": "create_book",
    "description": "New book review",
    "body": [
      "---",
      "layout: post",
      "title:  \"${1:name}\"",
      "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_MINUTE $CURRENT_TIMEZONE_OFFSET",
      "category: 📚 Littérature",
      "tags: []",
      "media_subpath: /assets/images",
      "image:",
      "  path: ${TM_FILENAME/(.*)\\..+$/$1/}.jpg",
      "country: ${2|FR,US,JP|}",
      "rating: 0",
      "release_date: 1970-01-01",
      "meta:",
      "  pages: 0",
      "  author: ",
      "  editor: ",
      "  url:",
      "  isbn: \"978-\"",
      "---",
      "",
      "***"
    ]
  },
  "New movie": {
