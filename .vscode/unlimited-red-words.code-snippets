      "category: 📺 Série TV",
      "tags: []",
      "media_subpath: /assets/images",
      "image:",
      "  path: ${TM_FILENAME/(.*)\\..+$/$1/}.jpg",
      "country: ${2|FR,US,JP|}",
      "rating: $3",
      "release_date: 1970-01-01",
      "meta:",
      "  imdb: \"\"",
      "  wikipedia: \"\"",
      "  start_date: ",
      "  end_date: ",
      "  network: \"\"",
      "  seasons: ",
      "  episodes: ",
      "---",
      "",
      "***"
    ]
  },
  "New video game": {
    "scope": "markdown",
    "prefix": "create_game",
    "description": "New Video game review",
    "body": [
      "---",
      "layout: post",
      "title:  \"${1:name}\"",
      "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_MINUTE $CURRENT_TIMEZONE_OFFSET",
      "category: 🎮 Jeux vidéo",
      "tags: []",
      "media_subpath: /assets/images",
      "image:",
      "  path: ${TM_FILENAME/(.*)\\..+$/$1/}.jpg",
      "country: ${2|FR,US,JP|}",
      "rating: $3",
      "release_date: 1970-01-01",
      "meta:",
      "  platform: \"\"",
      "  code: \"\"",
      "  steam: \"\"",
      "  retroachievements:",
      "    game_id: ",
      "    count: ",
      "    total: ",
      "---",
      "",
      "***"
    ]
  },
  "Series file": {
    "scope": "yaml",
    "prefix": "series_file",
    "description": "New _data/series/*.yml tracker file",
    "body": [
      "name: \"${1:Name}\"",
      "icon: ${2|🎮,📚,🎬,📺|}",
      "entries:",
      "groups:",
      "  - title: \"${3:Sub-series}\"",
      "    entries:",
      "      - \"${4:Full item title}\""
    ]
  },
  "Series backlog entry": {
    "scope": "yaml",
    "prefix": "series_entry",
    "description": "Backlog entry (no article yet) for a series file",
    "body": [
      "- title: \"${1:Title}\"",
      "  platform: ${2:Console}",
      "  release_date: ${3:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}"
    ]
  },
  "Series backlog entry, finished date unknown": {
    "scope": "yaml",
    "prefix": "series_entry_unknown",
    "description": "Backlog entry finished on an unknown date (shows ?)",
    "body": [
      "- title: \"${1:Title}\"",
      "  release_date: ${2:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}",
      "  finished_date: true"
    ]
  },
  "Series backlog entry, dropped": {
    "scope": "yaml",
    "prefix": "series_entry_dropped",
    "description": "Backlog entry abandoned/refused (gray, out of badge math)",
    "body": [
      "- title: \"${1:Title}\"",
      "  release_date: ${2:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}",
      "  dropped: true"
    ]
  },
  "Series group": {
    "scope": "yaml",
    "prefix": "series_group",
    "description": "Sub-series group (full titles, matched emoji-insensitive)",
    "body": [
      "- title: \"${1:Group name}\"",
      "  entries:",
      "    - \"${2:Full item title}\""
    ]
  },
  "Post series link": {
    "scope": "markdown",
    "prefix": "series_meta",
    "description": "Link a post to its series (meta.series), replaces the tag",
    "body": [
      "series: \"${1:Series name}\""
    ]
  },
  "New thoughts": {
    "scope": "markdown",
