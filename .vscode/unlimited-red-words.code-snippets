      "country: ${2|FR,US,JP|}",
      "rating: 0",
      "release_date: 1970-01-01",
      "meta:",
      "  imdb: \"\"",
      "---",
      "",
      "***"
    ]
  },
  "New TV series": {
    "scope": "markdown",
    "prefix": "create_series",
    "description": "New TV series review",
    "body": [
